# MindLens Environment Configuration
# ===================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- LLM Provider ---
# OpenRouter (recommended): https://openrouter.ai/keys
MINDLENS_LLM_PROVIDER=openrouter
MINDLENS_LLM_MODEL=Xiaomi/MiMo-V2.5-Pro
MINDLENS_LLM_API_KEY=sk-or-v1-YOUR_KEY_HERE
MINDLENS_LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Telegram ---
# Create a bot: https://t.me/BotFather
# Get your user ID: https://t.me/userinfobot
MINDLENS_TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE
MINDLENS_TELEGRAM_USER_ID=YOUR_USER_ID_HERE

# --- Vault ---
# Path to your Obsidian vault (where knowledge lives)
MINDLENS_VAULT_PATH=/path/to/your/obsidian/vault

# --- Runtime ---
MINDLENS_ENV=development
MINDLENS_LOG_LEVEL=INFO
